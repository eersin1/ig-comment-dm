# Copy to .env (git-ignored) and fill in. Never commit .env or paste its values anywhere else.

# The ID in your Supabase project's dashboard address: supabase.com/dashboard/project/<this part>
SUPABASE_PROJECT_REF=

# From `scripts/go-no-go.sh exchange`, which writes it here for you.
IG_TOKEN=
API_VERSION=v26.0

# Optional. Posting hours and dates on the dashboard use this zone, e.g. America/New_York.
# Leave empty to use this computer's time zone.
TIMEZONE=

# Optional. Lets Claude label the format, hook and topic of watched creators' reels on the Trends tab,
# at about $0.0015 a reel. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# Optional, for an email when the bot needs attention (token rejected, runs failing). Get a key at
# resend.com. With Resend's shared sender, ALERT_EMAIL must be the address on your Resend account.
RESEND_API_KEY=
ALERT_EMAIL=

# Filled in by scripts/deploy.sh. Leave empty.
SUPABASE_SECRET_KEY=
CRON_SECRET=
